# Settings for docker-compose.prod.yml. Copy to .env.prod and fill in every
# value marked REQUIRED. Never commit .env.prod.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Host port the API listens on. Bound to 127.0.0.1 only; point your reverse
# proxy at it.
API_PORT=3000

# Public URL users open in the browser. Used to build links in emails.
# REQUIRED. Example: https://music.example.com
AppBaseUrl=

# PostgreSQL. REQUIRED: all three passwords and the user name.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=panorama_music
# Password for the restricted panorama_app role the API connects as. The API
# creates the role on startup.
POSTGRES_APP_PASSWORD=

# JWT signing secret, at least 32 random characters. REQUIRED.
JWT__Secret=
JWT__AbsoluteSessionLifetimeDays=30

# First admin account, created when no admin exists. REQUIRED. The first sign-in
# is sent to the password-reset flow, so the password here is not kept.
Admin__Email=
Admin__Password=

# Outgoing email. The API sends plain SMTP without sign-in or TLS, so Smtp__Host
# must be a relay that accepts mail from the API container without credentials.
Email__From=
Email__ReplyTo=
Email__FromDisplayName=Panorama Music
Smtp__Host=
Smtp__Port=25

# Encrypts the Data Protection keyring at rest. REQUIRED. A base64-encoded PFX
# and its password. Store a copy outside this host: if you lose the certificate,
# every protected value becomes unrecoverable.
# docker-compose.prod.yml fixes DataProtection__KeyProtection to Certificate, so
# it is not a setting here. The same applies to Email__Provider (Smtp).
DataProtection__CertificateBase64=
DataProtection__CertificatePassword=

Serilog__MinimumLevel__Default=Information
