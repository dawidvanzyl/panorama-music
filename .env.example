# Per-worktree QA stack host bindings and image tag. Each of the parallel
# worktrees (panorama-music, panorama-music.1, panorama-music.2, ...) needs
# its own values here so their `docker compose --profile qa` stacks and their
# `e2e` Playwright suites can run concurrently without colliding on host
# ports or reading each other's data. Leave unset to reproduce today's single
# -worktree defaults (API 3000, DB 5433, smtp4dev SMTP 1025, smtp4dev UI
# 5000, image tag qa).
#
# Suggested allocation (offsets of 10 per worktree):
#   Worktree            | QA_API_PORT | QA_DB_PORT | QA_SMTP_PORT | QA_SMTP_UI_PORT | QA_IMAGE_TAG
#   panorama-music       | 3000        | 5433       | 1025         | 5000             | qa
#   panorama-music.1     | 3010        | 5443       | 1035         | 5010             | qa1
#   panorama-music.2     | 3020        | 5453       | 1045         | 5020             | qa2
QA_API_PORT=3000
QA_DB_PORT=5433
QA_SMTP_PORT=1025
QA_SMTP_UI_PORT=5000
QA_IMAGE_TAG=qa

# PostgreSQL credentials (used by both dev and qa profiles)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Password assigned to the restricted panorama_app role the API connects as
# (provisioned automatically on startup). Override the default on any
# reachable deployment.
POSTGRES_APP_PASSWORD=panorama_app_qa

# Database names per profile
POSTGRES_DB_DEV=panorama_music_dev
POSTGRES_DB_QA=panorama_music_qa

# Set to true to wipe the QA database, re-run all migrations, and re-seed on
# the next `docker compose --profile qa up` start. Reset to false afterwards.
# Never set to true in production.
RESET_DB=false

# JWT signing secret (min 32 characters)
JWT__Secret=change-me-to-a-secret-at-least-32-chars-long!!

# JWT issuer/audience pinned during validation, and the absolute session
# lifetime cap (in days) enforced independently of refresh-token rotation
JWT__Issuer=panorama-music-api
JWT__Audience=panorama-music-client
JWT__AbsoluteSessionLifetimeDays=30

# Admin seed credentials (used when RESET_DB=true or when no admin exists)
Admin__Email=admin@panorama-music.com
Admin__Password=ChangeMe123!

# Auth rate limits for the qa profile (relaxed so the E2E suite doesn't blow
# past production-strength limits within a single Playwright run)
RateLimiting__Auth__IpPermitLimit=1000
RateLimiting__Auth__AccountPermitLimit=1000
RateLimiting__Auth__WindowSeconds=60

# Email transport for the qa profile (Smtp -> smtp4dev). Production instead
# sets Email__Provider=Maileroo plus Maileroo__ApiKey, since Render blocks
# outbound SMTP.
Email__Provider=Smtp
Email__From=noreply@panorama-music.qa
Email__ReplyTo=noreply@panorama-music.qa
Email__FromDisplayName=Panorama Music (QA)

# SMTP target for the qa profile (smtp4dev, no auth required)
Smtp__Host=smtp4dev
Smtp__Port=25

# Base URL used to build links in emails (password reset, invites) sent by
# the qa profile. Left unset by default so it derives from QA_API_PORT above
# (docker-compose.yml default: http://localhost:${QA_API_PORT}) — only
# override if the app is reachable at a different host/URL than QA_API_PORT
# implies.
# AppBaseUrl=http://localhost:3000

# Set to true to make the qa profile call the live HIBP Pwned-Passwords API
# instead of skipping it (skipped by default so E2E CI doesn't depend on a
# third party). Never affects dev — Hibp is always live there.
Hibp__Enabled=false
